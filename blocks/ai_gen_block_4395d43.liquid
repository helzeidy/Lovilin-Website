{% doc %}
  @prompt
    scrolling announcement bar , make them 3 announcements 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-marquee-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; overflow: hidden; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; font-family: inherit; }
  .ai-marquee-{{ ai_gen_id }}__track { display: flex; width: max-content; min-height: 42px; align-items: center; animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.duration }}s linear infinite; }
  .ai-marquee-{{ ai_gen_id }}:hover .ai-marquee-{{ ai_gen_id }}__track, .ai-marquee-{{ ai_gen_id }}:focus-within .ai-marquee-{{ ai_gen_id }}__track { animation-play-state: paused; }
  .ai-marquee-{{ ai_gen_id }}__item { display: inline-flex; align-items: center; gap: 28px; padding: 10px 20px; white-space: nowrap; font-size: 14px; line-height: 1.4; }
  .ai-marquee-{{ ai_gen_id }}__link { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .ai-marquee-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .ai-marquee-{{ ai_gen_id }}__separator { font-size: 18px; line-height: 1; }
  @keyframes ai-marquee-scroll-{{ ai_gen_id }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .ai-marquee-{{ ai_gen_id }}__track { width: 100%; justify-content: center; animation: none; }
    .ai-marquee-{{ ai_gen_id }}__item[aria-hidden="true"] { display: none; }
  }
{% endstyle %}
<div class="ai-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-{{ ai_gen_id }}__track">
    {% for copy in (1..2) %}
      {% for number in (1..3) %}
        {% liquid
          assign message_key = 'message_' | append: number
          assign link_key = 'link_' | append: number
          assign announcement_message = block.settings[message_key]
          assign announcement_link = block.settings[link_key]
        %}
        {% if announcement_message != blank %}
          <div class="ai-marquee-{{ ai_gen_id }}__item" {% if copy == 2 %}aria-hidden="true"{% endif %}>
            {% if announcement_link != blank and copy == 1 %}<a class="ai-marquee-{{ ai_gen_id }}__link" href="{{ announcement_link }}">{{ announcement_message | escape }}</a>{% else %}<span>{{ announcement_message | escape }}</span>{% endif %}
            <span class="ai-marquee-{{ ai_gen_id }}__separator" aria-hidden="true">{{ block.settings.separator }}</span>
          </div>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Scrolling announcement",
  "settings": [
    { "type": "header", "content": "Announcement 1" },
    { "type": "text", "id": "message_1", "label": "Text", "default": "Discover something wonderful today" },
    { "type": "url", "id": "link_1", "label": "Link" },
    { "type": "header", "content": "Announcement 2" },
    { "type": "text", "id": "message_2", "label": "Text", "default": "Shop your household essentials" },
    { "type": "url", "id": "link_2", "label": "Link" },
    { "type": "header", "content": "Announcement 3" },
    { "type": "text", "id": "message_3", "label": "Text", "default": "Thoughtful care for every home" },
    { "type": "url", "id": "link_3", "label": "Link" },
    { "type": "select", "id": "separator", "label": "Separator", "options": [{ "value": "✦", "label": "Star" }, { "value": "•", "label": "Dot" }, { "value": "—", "label": "Dash" }], "default": "✦" },
    { "type": "range", "id": "duration", "label": "Scroll duration", "min": 10, "max": 60, "step": 5, "unit": "s", "default": 30 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#071E85" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Scrolling announcement" }],
  "tag": null,
  "class": "scrolling-announcement-block"
}
{% endschema %}