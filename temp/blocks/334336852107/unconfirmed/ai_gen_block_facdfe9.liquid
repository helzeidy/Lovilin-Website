{% doc %}
  @prompt
    scrolling announcement bar 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: inherit;
  }

  .ai-marquee-{{ ai_gen_id }}__track {
    display: flex;
    width: max-content;
    min-height: 42px;
    align-items: center;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.duration }}s linear infinite;
  }

  .ai-marquee-{{ ai_gen_id }}:hover .ai-marquee-{{ ai_gen_id }}__track,
  .ai-marquee-{{ ai_gen_id }}:focus-within .ai-marquee-{{ ai_gen_id }}__track {
    animation-play-state: paused;
  }

  .ai-marquee-{{ ai_gen_id }}__item {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding: 10px 20px;
    white-space: nowrap;
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-marquee-{{ ai_gen_id }}__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-marquee-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .ai-marquee-{{ ai_gen_id }}__separator {
    color: inherit;
    font-size: 18px;
    line-height: 1;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-marquee-{{ ai_gen_id }}__track {
      width: 100%;
      justify-content: center;
      animation: none;
    }

    .ai-marquee-{{ ai_gen_id }}__item[aria-hidden="true"] {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.message != blank %}
    <div class="ai-marquee-{{ ai_gen_id }}__track">
      {% for copy in (1..2) %}
        <div class="ai-marquee-{{ ai_gen_id }}__item" {% if copy == 2 %}aria-hidden="true"{% endif %}>
          {% if block.settings.link != blank and copy == 1 %}
            <a class="ai-marquee-{{ ai_gen_id }}__link" href="{{ block.settings.link }}">{{ block.settings.message | escape }}</a>
          {% else %}
            <span>{{ block.settings.message | escape }}</span>
          {% endif %}
          <span class="ai-marquee-{{ ai_gen_id }}__separator" aria-hidden="true">{{ block.settings.separator }}</span>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Scrolling announcement",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Announcement text",
      "default": "Discover something wonderful today"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement link"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separator",
      "options": [
        { "value": "✦", "label": "Star" },
        { "value": "•", "label": "Dot" },
        { "value": "—", "label": "Dash" }
      ],
      "default": "✦"
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Scroll duration",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 30
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#071E85"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Scrolling announcement"
    }
  ],
  "tag": null,
  "class": "scrolling-announcement-block"
}
{% endschema %}