{%- doc -%}
  Renders the cart cross-sell / upsell carousel.

  Recommendations are resolved client-side in this order:
    1. complementary products (set in the Search & Discovery app)
    2. related products (automatic), when the fallback setting is on
    3. the fallback collection chosen in theme settings

  Products already in the cart are excluded.

  @example
  {% render 'cart-upsell' %}
{%- enddoc -%}

{%- if settings.cart_upsell_enabled -%}
  {% # Always load the component: when the cart starts empty, the upsell is morphed in later and scripts inserted by a morph never run. %}
  <script
    src="{{ 'cart-upsell.js' | asset_url }}"
    type="module"
  ></script>
{%- endif -%}

{%- if settings.cart_upsell_enabled and cart.item_count > 0 -%}
  {%- liquid
    # Base recommendations on the most recently added item.
    assign anchor_product = cart.items.last.product

    assign excluded_ids = ''
    for item in cart.items
      assign excluded_ids = excluded_ids | append: item.product.id
      unless forloop.last
        assign excluded_ids = excluded_ids | append: ','
      endunless
    endfor

    assign fallback_collection = settings.cart_upsell_collection

    # Products the cart offer applies to (blank collection = every recommended product).
    assign discount_ids = ''
    assign offer_on = false
    if settings.cart_upsell_discount_percent > 0 or settings.cart_upsell_discount_code != blank
      assign offer_on = true
    endif
    if offer_on and settings.cart_upsell_discount_collection != blank
      for discount_product in settings.cart_upsell_discount_collection.products limit: 50
        assign discount_ids = discount_ids | append: discount_product.id | append: ','
      endfor
    endif
  -%}

  <cart-upsell
    class="cart-upsell"
    data-skip-subtree-update
    style="--cart-upsell-heading-size: {{ settings.cart_upsell_heading_size }}px;{% if settings.cart_upsell_heading_color != blank %} --cart-upsell-heading-color: {{ settings.cart_upsell_heading_color }};{% endif %}"
    data-url="{{ routes.product_recommendations_url }}.json"
    data-product-id="{{ anchor_product.id }}"
    data-exclude="{{ excluded_ids }}"
    data-intent="{{ settings.cart_upsell_intent }}"
    data-fallback-related="{% if settings.cart_upsell_fallback_related %}true{% else %}false{% endif %}"
    data-limit="{{ settings.cart_upsell_max }}"
    data-per-page="{{ settings.cart_upsell_per_page }}"
    data-heading="{{ settings.cart_upsell_heading | escape }}"
    data-add-label="{{ 'actions.add' | t | escape }}"
    data-choose-label="{{ 'actions.choose' | t | escape }}"
    data-discount-percent="{{ settings.cart_upsell_discount_percent }}"
    data-discount-label="{{ settings.cart_upsell_discount_label | escape }}"
    data-discount-products="{{ discount_ids }}"
    data-discount-code="{{ settings.cart_upsell_discount_code | strip | escape }}"
    data-button-class="{% if settings.cart_upsell_button_style == 'secondary' %}button button-secondary{% else %}button{% endif %}"
    data-money-format="{{ shop.money_format | strip_html | escape }}"
    data-currency="{{ cart.currency.iso_code }}"
  >
    {%- if fallback_collection != blank -%}
      <script type="application/json" data-upsell-fallback>
        [
          {%- for product in fallback_collection.products limit: settings.cart_upsell_max -%}
            {%- unless forloop.first %},{% endunless -%}
            {{ product | json }}
          {%- endfor -%}
        ]
      </script>
    {%- endif -%}
  </cart-upsell>

{%- endif -%}

{% stylesheet %}
  .cart-upsell {
    display: block;
  }

  /* Rendered by the component; absent when there is nothing to recommend. */
  .cart-upsell__inner {
    padding-block: var(--padding-lg) var(--padding-md);
    border-block-start: 1px solid var(--color-border, rgb(from var(--color-foreground) r g b / 12%));
  }

  /*
    In the drawer, sit at the bottom of the scrolling area, directly above the
    sticky summary (discount, totals, checkout), and line up with the items.
  */
  .cart-drawer .cart-upsell {
    margin-block-start: auto;
    padding-inline: var(--cart-drawer-padding);

    @media screen and (min-width: 750px) {
      padding-inline: var(--cart-drawer-padding-desktop);
    }
  }

  /* Keep a gap between the last cart item and the upsell when content is tall. */
  .cart-drawer__content:has(.cart-upsell__inner) .cart-drawer__items {
    padding-block-end: var(--gap-xl);
  }

  /*
    The summary also uses margin-top: auto to stick to the bottom. With two auto
    margins the free space is split, leaving a gap under the upsell. Let the
    upsell take all of it so it sits flush on top of the summary.
  */
  .cart-drawer__content:has(.cart-upsell__inner) .cart-drawer__summary {
    margin-top: 0;
  }

  .cart-upsell__heading {
    margin: 0 0 var(--padding-md);
    font-size: var(--cart-upsell-heading-size, 0.875rem);
    color: var(--cart-upsell-heading-color, inherit);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  /* Swipeable track: native scrolling with one product snapping into view at a time. */
  .cart-upsell__list {
    --cart-upsell-gap: var(--padding-sm, 8px);

    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--cart-upsell-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .cart-upsell__list::-webkit-scrollbar {
    display: none;
  }

  /*
    Cards are sized so part of the next one peeks in, hinting that the row
    swipes. --cart-upsell-peek is the fraction of a card left visible.
  */
  .cart-upsell__item {
    --cart-upsell-peek: 0.15;

    flex: 0 0
      calc(
        (100% - var(--cart-upsell-per-view, 1) * var(--cart-upsell-gap)) /
          (var(--cart-upsell-per-view, 1) + var(--cart-upsell-peek))
      );
    scroll-snap-align: start;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--padding-md);
    padding: var(--padding-sm);
    border: 1px solid rgb(from var(--color-foreground) r g b / 10%);
    border-radius: var(--style-border-radius-inputs, 8px);
  }

  .cart-upsell__item:only-child {
    flex-basis: 100%;
  }

  .cart-upsell__media {
    display: block;
    width: 64px;
    height: 64px;
    border-radius: var(--cart-thumbnail-border-radius, 6px);
    overflow: hidden;
    background: rgb(from var(--color-foreground) r g b / 4%);
  }

  .cart-upsell__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cart-upsell__info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cart-upsell__title {
    color: inherit;
    text-decoration: none;
    font-size: var(--font-size--sm, 0.875rem);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-upsell__title:hover {
    text-decoration: underline;
  }

  .cart-upsell__price {
    margin: 0;
    font-size: var(--font-size--xs, 0.8125rem);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    opacity: 0.85;
  }

  .cart-upsell__compare {
    opacity: 0.6;
  }

  .cart-upsell__sale {
    font-weight: 600;
  }

  /* Cart offer badge, e.g. "Save 15%". */
  .cart-upsell__badge {
    align-self: flex-start;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-primary-button-text, #fff);
    background: var(--color-primary-button-background, currentcolor);
  }

  .cart-upsell__select[hidden] {
    display: none;
  }

  .cart-upsell__select {
    width: 100%;
    max-width: 11rem;
    font: inherit;
    font-size: var(--font-size--xs, 0.8125rem);
    padding: 0.3rem 0.5rem;
    border: 1px solid rgb(from var(--color-foreground) r g b / 20%);
    border-radius: var(--style-border-radius-inputs, 6px);
    background: transparent;
    color: inherit;
  }

  .cart-upsell .cart-upsell__add {
    min-width: 0;
    min-height: 0;
    padding: 0.5rem 1rem;
    font-size: var(--font-size--xs, 0.8125rem);
    white-space: nowrap;
  }

  .cart-upsell__add[disabled] {
    opacity: 0.6;
    pointer-events: none;
  }

{% endstylesheet %}
