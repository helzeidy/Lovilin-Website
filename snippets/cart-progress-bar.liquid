<div id="cart-progress-bar-component" class="cart-progress-banner" style="display:none;">
  <div class="cart-progress-message" id="cart-progress-text"></div>
  <div class="cart-progress-bar-container">
    <div class="cart-progress-bar-fill" id="cart-progress-fill" style="width: 0%;"></div>
  </div>
</div>

<style>
  .cart-progress-banner {
    margin: 15px 0;
    padding: 15px;
    background: rgba(var(--color-foreground), 0.03);
    border-radius: var(--border-radius-shape, 8px);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    grid-column: 1 / -1; /* Span full width in grid layouts */
  }
  .cart-progress-message {
    font-size: 0.95rem;
    margin-bottom: 8px;
    text-align: center;
  }
  .cart-progress-bar-container {
    width: 100%;
    height: 8px;
    background: rgba(var(--color-foreground), 0.1);
    border-radius: 4px;
    overflow: hidden;
  }
  .cart-progress-fill {
    height: 100%;
    background: rgb(var(--color-button, 0, 0, 0));
    width: 0%;
    transition: width 0.4s ease-in-out;
  }
</style>

<script>
  (function() {
    const GOAL = 85000; // 850 EGP in cents
    const TARGET_HANDLE = 'color-catcher-sheets';

    async function updateProgressBar() {
      try {
        const res = await fetch('/cart.js');
        const cart = await res.json();
        
        const banner = document.getElementById('cart-progress-bar-component');
        const textEl = document.getElementById('cart-progress-text');
        const fillEl = document.getElementById('cart-progress-fill');
        if (!banner || !textEl || !fillEl) return;

        // Calculate total excluding the gift itself so adding it doesn't skew thresholds
        let qualifyingTotal = 0;
        let giftItem = null;

        cart.items.forEach(item => {
          if (item.handle === TARGET_HANDLE) {
            giftItem = item;
          } else {
            qualifyingTotal += item.final_line_price; // Uses final price accounting for discounts
          }
        });

        // Determine percentage & formatting
        let percent = (qualifyingTotal / GOAL) * 100;
        if (percent > 100) percent = 100;

        const remaining = Math.max(0, GOAL - qualifyingTotal);
        const formatMoney = (cents) => {
          return (cents / 100).toFixed(2) + ' EGP';
        };

        if (qualifyingTotal >= GOAL) {
          textEl.innerHTML = `<span>🎉 You unlocked your free Color Catcher Sheets!</span>`;
          fillEl.style.width = '100%';
          banner.style.display = 'block';

          // Auto-add if goal reached but gift not in cart
          if (!giftItem) {
            await addGiftProduct();
          }
        } else {
          textEl.innerHTML = `<span>Add <strong>${formatMoney(remaining)}</strong> more to get Free Color Catcher Sheets!</span>`;
          fillEl.style.width = percent + '%';
          banner.style.display = 'block';

          // Auto-remove if cart drops below threshold and gift is in cart
          if (giftItem) {
            await removeGiftProduct(giftItem.key);
          }
        }
      } catch (e) {
        console.error('Cart progress bar error:', e);
      }
    }

    async function addGiftProduct() {
      try {
        const prodRes = await fetch(`/products/${TARGET_HANDLE}.js`);
        if (!prodRes.ok) return;
        const product = await prodRes.json();
        const variantId = product.variants[0].id;

        await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        });
        
        // Trigger cart update event or reload to sync UI
        window.location.reload();
      } catch (err) {
        console.error('Failed to add gift:', err);
      }
    }

    async function removeGiftProduct(itemKey) {
      try {
        await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: itemKey, quantity: 0 })
        });
        
        window.location.reload();
      } catch (err) {
        console.error('Failed to remove gift:', err);
      }
    }

    // Run on initial page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateProgressBar);
    } else {
      updateProgressBar();
    }
  })();
</script>