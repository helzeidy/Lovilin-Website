<div id="cart-progress-bar-component" class="cart-progress-banner">
  <div class="cart-progress-message" id="cart-progress-text">Checking cart progress...</div>
  
  <div class="cart-progress-bar-wrapper">
    <div class="cart-progress-bar-container">
      <div class="cart-progress-bar-fill" id="cart-progress-fill" style="width: 0%;"></div>
    </div>
    
    <!-- Product node with plus sign at the end of the bar -->
    <div class="cart-progress-gift-node" id="cart-gift-node" title="Add Color Catcher Sheets">
      <img id="cart-gift-img" src="" alt="Color Catcher Sheets" style="display:none;" />
      <div class="cart-gift-plus-badge" id="cart-gift-badge">+</div>
    </div>
  </div>
</div>

<style>
  .cart-progress-banner {
    margin: 15px 0;
    padding: 15px;
    background: rgba(var(--color-foreground), 0.03);
    border-radius: var(--border-radius-shape, 8px);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    grid-column: 1 / -1;
  }
  .cart-progress-message {
    font-size: 0.95rem;
    margin-bottom: 12px;
    text-align: center;
  }
  .cart-progress-bar-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    margin-top: 10px;
    margin-right: 20px;
  }
  .cart-progress-bar-container {
    width: 100%;
    height: 8px;
    background: rgba(var(--color-foreground), 0.1);
    border-radius: 4px;
    overflow: visible;
  }
  .cart-progress-bar-fill {
    height: 100%;
    background: rgb(var(--color-button, 0, 0, 0));
    width: 0%;
    border-radius: 4px;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cart-progress-gift-node {
    position: absolute;
    right: -20px;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    background: var(--color-background, #fff);
    border: 2px solid rgb(var(--color-button, 0, 0, 0));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    transition: transform 0.2s ease, opacity 0.2s ease;
    overflow: hidden;
    z-index: 2;
  }
  .cart-progress-gift-node:hover {
    transform: translateY(-50%) scale(1.1);
  }
  .cart-progress-gift-node.is-added {
    border-color: #2e7d32;
    background: #e8f5e9;
  }
  .cart-progress-gift-node img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-gift-plus-badge {
    font-size: 20px;
    font-weight: bold;
    line-height: 1;
    color: rgb(var(--color-button, 0, 0, 0));
  }
  .cart-progress-gift-node.is-added .cart-gift-plus-badge {
    color: #2e7d32;
  }
</style>

<script>
  (function() {
    const GOAL = 85000; // 850 EGP in cents
    const TARGET_HANDLE = 'color-catcher-sheets';
    let productVariantId = null;

    async function initGiftData() {
      try {
        const res = await fetch(`/products/${TARGET_HANDLE}.js`);
        if (res.ok) {
          const product = await res.json();
          productVariantId = product.variants[0].id;
          
          const imgEl = document.getElementById('cart-gift-img');
          if (imgEl && product.featured_image) {
            imgEl.src = product.featured_image;
          }
        }
      } catch (e) {
        console.error('Error fetching gift product info:', e);
      }
    }

    async function updateProgressBar() {
      try {
        const res = await fetch('/cart.js', { headers: { 'Accept': 'application/json' } });
        if (!res.ok) throw new Error('Failed to fetch cart');
        const cart = await res.json();
        
        const textEl = document.getElementById('cart-progress-text');
        const fillEl = document.getElementById('cart-progress-fill');
        const nodeEl = document.getElementById('cart-gift-node');
        const badgeEl = document.getElementById('cart-gift-badge');
        const imgEl = document.getElementById('cart-gift-img');
        if (!textEl || !fillEl) return;

        let qualifyingTotal = 0;
        let giftInCart = false;

        cart.items.forEach(item => {
          if (item.handle === TARGET_HANDLE) {
            giftInCart = true;
          } else {
            qualifyingTotal += item.final_line_price;
          }
        });

        let percent = (qualifyingTotal / GOAL) * 100;
        if (percent > 100) percent = 100;

        const remaining = Math.max(0, GOAL - qualifyingTotal);
        const formatMoney = (cents) => (cents / 100).toFixed(2) + ' EGP';

        // Update visual states for the node badge
        if (giftInCart) {
          nodeEl.classList.add('is-added');
          badgeEl.textContent = '✓';
          if (imgEl && imgEl.src) imgEl.style.display = 'block';
        } else {
          nodeEl.classList.remove('is-added');
          badgeEl.textContent = '+';
          if (imgEl && !imgEl.src) imgEl.style.display = 'none';
          else if (imgEl && imgEl.src) imgEl.style.display = 'block';
        }

        if (qualifyingTotal >= GOAL) {
          if (giftInCart) {
            textEl.innerHTML = `<span>🎉 Color Catcher Sheets is in your cart!</span>`;
          } else {
            textEl.innerHTML = `<span>🎉 Goal reached! Click the badge icon to add your free gift!</span>`;
          }
          fillEl.style.width = '100%';
        } else {
          textEl.innerHTML = `<span>Add <strong>${formatMoney(remaining)}</strong> more to unlock Color Catcher Sheets!</span>`;
          fillEl.style.width = percent + '%';
        }
      } catch (e) {
        console.error('Cart progress bar error:', e);
      }
    }

    // Handle click event on the product node to add item smoothly without closing drawer
    document.addEventListener('click', async function(e) {
      const giftNode = e.target.closest('#cart-gift-node');
      if (giftNode) {
        if (!productVariantId || giftNode.classList.contains('is-added')) return;
        
        try {
          giftNode.style.opacity = '0.6';
          const addRes = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: productVariantId, quantity: 1 })
          });
          
          if (addRes.ok) {
            // Trigger native theme update events so side drawer refreshes its contents seamlessly
            document.dispatchEvent(new CustomEvent('cart:build', { bubbles: true }));
            document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
            document.dispatchEvent(new CustomEvent('shopify:cart:changed', { bubbles: true }));
            
            // Re-run progress check immediately without reloading the window
            await updateProgressBar();
            
            // If the theme has a global cart refresh trigger or global function, dispatch it
            if (window.Shopify && typeof window.Shopify.getCart === 'function') {
              window.Shopify.getCart();
            } else {
              // Fallback dispatch for generic drawer refresh routes
              fetch(window.location.href).then(res => res.text()).then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newDrawer = doc.querySelector('.cart-drawer__inner');
                const currentDrawer = document.querySelector('.cart-drawer__inner');
                if (newDrawer && currentDrawer) {
                  currentDrawer.innerHTML = newDrawer.innerHTML;
                }
              });
            }
          }
        } catch (err) {
          console.error('Failed to add gift item:', err);
        } finally {
          giftNode.style.opacity = '1';
        }
      }
    });

    // Listen to container changes or cart events to sync progress smoothly
    initGiftData();
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      updateProgressBar();
    } else {
      document.addEventListener('DOMContentLoaded', updateProgressBar);
    }
    
    document.addEventListener('cart:updated', updateProgressBar);
    document.addEventListener('shopify:cart:changed', updateProgressBar);
    window.addEventListener('popstate', updateProgressBar);
  })();
</script>